From 2c2a0ce900eede6fb141e3b8a6a802668a1d0cb2 Mon Sep 17 00:00:00 2001
From: wanghaolong613 <wanghaolong613@163.com>
Date: Tue, 2 Jun 2026 09:35:12 +0800
Subject: [PATCH] refactor: optimize error message concatenation in
 default_validator

---
 binding/default_validator.go | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/binding/default_validator.go b/binding/default_validator.go
index 8203bcaaf8..f27d437bcc 100644
--- a/binding/default_validator.go
+++ b/binding/default_validator.go
@@ -32,7 +32,10 @@ func (err SliceValidationError) Error() string {
 			if b.Len() > 0 {
 				b.WriteString("\n")
 			}
-			b.WriteString("[" + strconv.Itoa(i) + "]: " + err[i].Error())
+			b.WriteString("[")
+			b.WriteString(strconv.Itoa(i))
+			b.WriteString("]: ")
+			b.WriteString(err[i].Error())
 		}
 	}
 	return b.String()
